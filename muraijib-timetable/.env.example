# وضع البيانات: local (IndexedDB في المتصفح، للتقييم الفوري) أو supabase (الإنتاج)
NEXT_PUBLIC_DATA_MODE=local

# Supabase — تُملأ عند الانتقال للإنتاج
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# مساعد الجدول الذكي — اختياري.
# بدونه يعمل المساعد بمفسّر الأوامر الحتمي (يغطي الأوامر الشائعة بلا نموذج لغوي).
ANTHROPIC_API_KEY=
